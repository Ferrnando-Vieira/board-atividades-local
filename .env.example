# Copie para .env.local (Copy-Item .env.example .env.local) e ajuste.
# .env.local vale para npm run dev, npm start e os scripts de manutenção, e é
# ignorado pelo Git. Uma variável definida no próprio terminal tem prioridade
# sobre o arquivo. Nenhum valor daqui é segredo: a conta administrativa é
# criada em /configuracao-inicial com o código de uso único que
# "npm run inicializar" (ou "npm run admin:codigo") mostra no terminal.

# Interface em que o servidor escuta. 127.0.0.1 = só esta máquina (padrão
# seguro). Para outros computadores da rede local abrirem o board, use
# 0.0.0.0: o servidor continua respondendo em 127.0.0.1 nesta máquina e os
# links passam a usar o IP da LAN, detectado sozinho (troca de IP via DHCP não
# exige ajuste). Libere a porta só no perfil Privado do Firewall do Windows
# (README, seção "Acesso pela rede local"). Nunca crie redirecionamento de
# porta no roteador nem túnel para a internet.
HOST=127.0.0.1
PORTA=3000

# Endereço que os outros dispositivos usam para abrir o board, sem barra no
# fim (ex.: https://board.lan atrás de um proxy HTTPS). É a base dos links de
# compartilhamento e do endereço da API exibido em Integrações.
# Vazio = http://HOST:PORTA; com HOST=0.0.0.0, http://<IP da LAN>:PORTA.
URL_BASE_LAN=

# Caminhos relativos partem da raiz do projeto; no Windows, use barras normais
# ou invertidas sem aspas (ex.: D:/board/board-atividades.sqlite). Os dois
# devem ficar num disco local desta máquina, fora de pastas sincronizadas
# (OneDrive, Dropbox) e de compartilhamentos de rede, e nunca dentro de public/.
CAMINHO_BANCO_SQLITE=./dados/board-atividades.sqlite
DIRETORIO_ANEXOS=./dados/anexos

# true somente quando o board for acessado por HTTPS (proxy TLS local): o
# cookie de sessão ganha o atributo Secure. Com true e acesso por http://<IP>,
# o navegador descarta o cookie e a entrada não se completa.
COOKIE_SEGURO=false

# No Windows, o servidor mostra os lembretes como toast do sistema no horário,
# mesmo com o navegador fechado. false desliga.
NOTIFICACOES_WINDOWS=true

# Servidor MCP (npm run mcp, registrado no .mcp.json): token de API gerado em
# Integrações. É SEGREDO: preencha só no .env.local (ignorado pelo Git), nunca
# aqui. BOARD_API_URL vazio = http://127.0.0.1:PORTA/api/v1.
